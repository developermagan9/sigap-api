# ── Database ──────────────────────────────────────────
DATABASE_URL="postgresql://sigap:sigap_secret@localhost:5432/sigap_bansos?schema=public"

# ── Auth ──────────────────────────────────────────────
# WAJIB. Minimal 32 karakter acak. Buat dengan: openssl rand -hex 32
JWT_SECRET="change-me-to-a-strong-random-string"
JWT_EXPIRES_IN="1h"

# ── Security / Hashing ────────────────────────────────
# WAJIB. Pepper untuk SHA-256 hash NIK/No.KK — TEPAT 64 karakter hex.
# Buat dengan: openssl rand -hex 32
# Simpan di secret manager, JANGAN di database yang sama (ruang NIK 16 digit
# trivial di-enumerate kalau peppernya ikut bocor). Tidak bisa dirotasi tanpa
# migrasi — lihat docs/16-Konfigurasi-Kredensial.md §1.3.
SYSTEM_PEPPER="change-me-to-a-64-char-hex-string"

# WAJIB. Kunci AES-256 untuk enkripsi kolom PII — TEPAT 64 karakter hex.
# Buat dengan: openssl rand -hex 32
# Menggantinya membuat seluruh PII lama tidak bisa didekripsi.
DB_ENCRYPTION_KEY="change-me-to-a-64-char-hex-key"

# ── Blockchain (OPSIONAL) ─────────────────────────────
# Kosongkan/biarkan placeholder untuk mode simulasi — sistem tetap berjalan
# penuh dan menandai responsnya `simulated: true`.
# Cara mendapatkan wallet, POL faucet, RPC, dan alamat kontrak:
#   docs/16-Konfigurasi-Kredensial.md §2 (langkah demi langkah, semuanya gratis)
RPC_URL="https://rpc-amoy.polygon.technology"
CHAIN_ID=80002
ADMIN_PRIVATE_KEY="0x_your_deployer_private_key"
REGISTRY_CONTRACT_ADDRESS="0x..."
DISBURSEMENT_CONTRACT_ADDRESS="0x..."
DANA_TOKEN_ADDRESS="0x..."

# Basis URL block explorer untuk tautan tx/alamat. Default Polygon Amoy.
EXPLORER_BASE_URL="https://amoy.polygonscan.com"

# ── Server ────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
