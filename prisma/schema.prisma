generator client {
  provider        = "prisma-client-js"
  // `postgresqlExtensions` dibutuhkan supaya pg_trgm di bawah ikut dibuat oleh
  // `prisma db push` / `migrate` — dipakai index fuzzy-match nama+alamat.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// ─── Enums ───────────────────────────────────────────

enum UserRole {
  admin
  petugas
  verifikator
  auditor
}

enum VerifikasiStatus {
  pending
  verified
  rejected
}

enum HubunganKeluarga {
  kepala
  istri_suami
  anak
  orang_tua
  famili_lain
}

enum ProgramStatus {
  draft
  clustering
  ranking
  alokasi
  reviewed
  approved
  disbursed
}

enum SkemaAlokasi {
  flat
  berjenjang
  proporsional
}

enum RankingStatus {
  draft
  final
}

enum DisbursementStatus {
  pending
  claimed
  failed
}

enum StatusSanggahan {
  pending
  diterima
  ditolak
}

enum WalletType {
  mandiri
  custodial
}

// ─── Models ──────────────────────────────────────────

/// Wilayah KERJA program — subset desa/kelurahan yang benar-benar didata.
/// Sengaja bukan salinan seluruh Indonesia: `user.wilayah_id` memakai tabel ini
/// sebagai batas kewenangan, dan dropdown pendataan petugas memilih dari sini.
/// Barisnya dibuat dengan memilih dari `wilayah_referensi` (lihat WilayahService.create).
model Wilayah {
  id        String @id @default(uuid()) @db.Uuid
  /// Kode Kepmendagri tingkat desa (`PP.KK.CC.DDDD`) dari `wilayah_referensi`.
  /// Unik supaya satu desa tidak bisa terdaftar dua kali sebagai wilayah kerja —
  /// nama desa TIDAK unik di Indonesia (27.544 desa memakai nama yang juga
  /// dipakai desa lain; "Sidomulyo" saja ada 98), jadi nama tidak bisa jadi kunci.
  /// Nullable untuk baris lama yang dibuat sebelum referensi wilayah ada.
  kode      String? @unique @db.VarChar(13)
  provinsi  String @db.VarChar(100)
  kabupaten String @db.VarChar(100)
  kecamatan String @db.VarChar(100)
  desa      String @db.VarChar(100)

  rumahTangga RumahTangga[]
  users       User[]

  @@map("wilayah")
}

/// Referensi wilayah administratif Indonesia sesuai Kepmendagri 300.2.2-2138/2025.
/// READ-ONLY bagi aplikasi: diisi `npm run wilayah:seed` dari
/// `prisma/data/wilayah-indonesia.csv`, tidak pernah ditulis lewat API.
model WilayahReferensi {
  /// `34` (provinsi), `34.04` (kab/kota), `34.04.01` (kecamatan), `34.04.01.2001` (desa).
  kode      String  @id @db.VarChar(13)
  nama      String  @db.VarChar(100)
  /// 1 provinsi, 2 kabupaten/kota, 3 kecamatan, 4 desa/kelurahan.
  level     Int     @db.SmallInt
  /// Kode induk = kode ini dikurangi satu segmen terakhir; `null` untuk provinsi.
  indukKode String? @map("induk_kode") @db.VarChar(13)

  /// Menopang query cascade `WHERE induk_kode = ? ORDER BY nama`.
  @@index([indukKode, nama])
  /// Menopang pencarian desa lintas provinsi `WHERE level = 4 AND nama ILIKE ?`.
  @@index([level, nama])
  @@map("wilayah_referensi")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  username      String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  nama          String    @db.VarChar(255)
  role          UserRole
  wilayahId     String?   @map("wilayah_id") @db.Uuid
  walletAddress String?   @map("wallet_address") @db.VarChar(42)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz

  wilayah           Wilayah?           @relation(fields: [wilayahId], references: [id], onDelete: SetNull)
  auditLogs         AuditLog[]
  sanggahanDiajukan SanggahanRequest[] @relation("SanggahanDiajukan")
  sanggahanDitinjau SanggahanRequest[] @relation("SanggahanDitinjau")

  @@map("users")
}

model RumahTangga {
  id                      String           @id @default(uuid()) @db.Uuid
  nikKkHash               String           @map("nik_kk_hash") @db.VarChar(64)
  noKkHash                String           @map("no_kk_hash") @db.VarChar(64)
  wilayahId               String           @map("wilayah_id") @db.Uuid
  pendapatanPerKapita     Decimal          @map("pendapatan_per_kapita") @db.Decimal(15, 2)
  jumlahTanggungan        Int              @default(0) @map("jumlah_tanggungan")
  jumlahDisabilitasLansia Int              @default(0) @map("jumlah_disabilitas_lansia")
  skorKondisiRumah        Int              @map("skor_kondisi_rumah") @db.SmallInt
  skorAksesPendidikan     Int              @map("skor_akses_pendidikan") @db.SmallInt
  riwayatBansosSebelumnya Boolean          @default(false) @map("riwayat_bansos_sebelumnya")
  statusVerifikasi        VerifikasiStatus @default(pending) @map("status_verifikasi")
  flaggedDuplicate        Boolean          @default(false) @map("flagged_duplicate")
  periodeId               String?          @map("periode_id") @db.Uuid
  // Wallet penerima dikumpulkan saat pendataan — dipakai langsung sebagai `recipient`
  // saat build-merkle, menggantikan alamat palsu yang sebelumnya di-derive dari hash NIK.
  // `mandiri` = wallet milik penerima sendiri; `custodial` = dikelola pendamping desa
  // (lihat 07-Security-Privacy-Ethics.md §6). Nullable karena belum wajib di seluruh alur —
  // fallback custodial deterministik tetap ada di blockchain.service.ts bila kosong.
  walletAddress           String?          @map("wallet_address") @db.VarChar(42)
  jenisWallet             WalletType?      @map("jenis_wallet")
  // Hasil assignment K-Means terakhir untuk baris ini (05-Algorithm-Design.md §3).
  // Disimpan saat `run-clustering` supaya `run-topsis` tidak perlu menjalankan
  // ulang K-Means di dalam loop per cluster — perhitungan ulang itu sempat
  // menghasilkan assignment yang berbeda karena urutan baris tidak dijamin.
  // `clusterIndex` = peringkat kerentanan (0 = Sangat Rentan), sama dengan
  // ClusterResult.clusterIndex; `clusterResultId` menunjuk baris agregatnya.
  clusterIndex            Int?             @map("cluster_index")
  clusterResultId         String?          @map("cluster_result_id") @db.Uuid
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  wilayah             Wilayah              @relation(fields: [wilayahId], references: [id])
  periode             PeriodeProgram?      @relation(fields: [periodeId], references: [id])
  clusterResult       ClusterResult?       @relation(fields: [clusterResultId], references: [id], onDelete: SetNull)
  pii                 RumahTanggaPii?
  anggota             AnggotaKeluarga[]
  rankingResults      RankingResult[]
  disbursementRecords DisbursementRecord[]
  sanggahanRequests   SanggahanRequest[]

  // Dedup NIK/No.KK keras "per periode program" (03-Data-Model.md §1.1) — satu KK
  // yang sama BOLEH terdaftar lagi di periode berikutnya, tapi tidak dua kali di
  // periode yang sama. Baris tanpa periode_id (data lepas/test) tidak di-dedup
  // karena NULL dianggap distinct oleh Postgres.
  @@unique([periodeId, nikKkHash])
  @@unique([periodeId, noKkHash])
  @@map("rumah_tangga")
}

model RumahTanggaPii {
  rumahTanggaId         String   @id @map("rumah_tangga_id") @db.Uuid
  nikKepalaKeluargaEnc  Bytes    @map("nik_kepala_keluarga_enc")
  noKkEnc               Bytes    @map("no_kk_enc")
  namaKepalaKeluargaEnc Bytes    @map("nama_kepala_keluarga_enc")
  alamatDetailEnc       Bytes    @map("alamat_detail_enc")
  namaNormalized        String   @map("nama_normalized") @db.VarChar(255)
  alamatNormalized      String   @default("") @map("alamat_normalized") @db.VarChar(500)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz

  rumahTangga RumahTangga @relation(fields: [rumahTanggaId], references: [id], onDelete: Cascade)

  // Index trigram untuk prefilter kandidat duplikat. Tanpa ini setiap insert
  // menarik SELURUH tabel ke memori lalu menghitung Jaro-Winkler satu per satu
  // (O(n) per insert). Dengan index ini kandidat disaring dulu lewat operator
  // similarity Postgres, Jaro-Winkler cuma jalan di segelintir baris teratas.
  @@index([namaNormalized(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([alamatNormalized(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("rumah_tangga_pii")
}

model AnggotaKeluarga {
  id                String           @id @default(uuid()) @db.Uuid
  rumahTanggaId     String           @map("rumah_tangga_id") @db.Uuid
  nikHash           String           @map("nik_hash") @db.VarChar(64)
  nikEnc            Bytes            @map("nik_enc")
  namaEnc           Bytes            @map("nama_enc")
  hubungan          HubunganKeluarga
  tanggalLahir      DateTime         @map("tanggal_lahir") @db.Date
  statusDisabilitas Boolean          @default(false) @map("status_disabilitas")
  isTanggungan      Boolean          @default(true) @map("is_tanggungan")

  rumahTangga RumahTangga @relation(fields: [rumahTanggaId], references: [id], onDelete: Cascade)

  // Dedup NIK anggota juga discope per periode (lewat relasi rumahTangga.periodeId
  // di rumah-tangga.service.ts). Index non-unik untuk mempercepat lookup itu.
  @@index([nikHash])
  @@map("anggota_keluarga")
}

model PeriodeProgram {
  id               String        @id @default(uuid()) @db.Uuid
  namaProgram      String        @map("nama_program") @db.VarChar(255)
  anggaranTotal    Decimal       @map("anggaran_total") @db.Decimal(18, 2)
  biayaOperasional Decimal       @default(0) @map("biaya_operasional") @db.Decimal(18, 2)
  kCluster         Int           @default(4) @map("k_cluster")
  clusterPrioritas Int[]         @default([0, 1]) @map("cluster_prioritas")
  bobotKriteria    Json          @map("bobot_kriteria")
  skemaAlokasi     SkemaAlokasi  @default(flat) @map("skema_alokasi")
  nominalDasar     Decimal       @default(500000) @map("nominal_dasar") @db.Decimal(15, 2)
  faktorCluster    Json?         @map("faktor_cluster")
  kuotaPenerima    Int?          @map("kuota_penerima")
  totalAlokasi     Decimal?      @map("total_alokasi") @db.Decimal(18, 2)
  sisaAnggaran     Decimal?      @map("sisa_anggaran") @db.Decimal(18, 2)
  // Skor silhouette dari run clustering terakhir (validasi pemilihan k,
  // 05-Algorithm-Design.md §3.2). Nullable: baru terisi setelah clustering jalan.
  silhouetteScore  Decimal?      @map("silhouette_score") @db.Decimal(6, 5)
  merkleRoot       String?       @map("merkle_root") @db.VarChar(66)
  contractAddress  String?       @map("contract_address") @db.VarChar(42)
  txHash           String?       @map("tx_hash") @db.VarChar(66)
  status           ProgramStatus @default(draft)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  rumahTangga         RumahTangga[]
  clusterResults      ClusterResult[]
  rankingResults      RankingResult[]
  disbursementRecords DisbursementRecord[]

  @@map("periode_program")
}

model ClusterResult {
  id            String @id @default(uuid()) @db.Uuid
  periodeId     String @map("periode_id") @db.Uuid
  clusterIndex  Int    @map("cluster_index")
  label         String @db.VarChar(50)
  centroid      Json
  jumlahAnggota Int    @map("jumlah_anggota")

  periode        PeriodeProgram  @relation(fields: [periodeId], references: [id], onDelete: Cascade)
  rankingResults RankingResult[]
  rumahTangga    RumahTangga[]

  @@unique([periodeId, clusterIndex])
  @@map("cluster_result")
}

model RankingResult {
  id                String        @id @default(uuid()) @db.Uuid
  rumahTanggaId     String        @map("rumah_tangga_id") @db.Uuid
  periodeId         String        @map("periode_id") @db.Uuid
  clusterId         String        @map("cluster_id") @db.Uuid
  skorTopsis        Decimal       @map("skor_topsis") @db.Decimal(6, 5)
  dPlus             Decimal?      @map("d_plus") @db.Decimal(10, 8)
  dMinus            Decimal?      @map("d_minus") @db.Decimal(10, 8)
  rank              Int
  breakdownKriteria Json          @map("breakdown_kriteria")
  terpilih          Boolean       @default(false)
  amount            Decimal?      @db.Decimal(15, 2)
  status            RankingStatus @default(draft)

  rumahTangga RumahTangga    @relation(fields: [rumahTanggaId], references: [id], onDelete: Cascade)
  periode     PeriodeProgram @relation(fields: [periodeId], references: [id], onDelete: Cascade)
  cluster     ClusterResult  @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([periodeId, rumahTanggaId])
  @@map("ranking_result")
}

model DisbursementRecord {
  id             String             @id @default(uuid()) @db.Uuid
  reference      String             @unique @db.VarChar(20)
  rumahTanggaId  String             @map("rumah_tangga_id") @db.Uuid
  periodeId      String             @map("periode_id") @db.Uuid
  walletAddress  String             @map("wallet_address") @db.VarChar(42)
  jenisWallet    WalletType         @default(mandiri) @map("jenis_wallet")
  amount         Decimal            @db.Decimal(15, 2)
  merkleLeafHash String             @map("merkle_leaf_hash") @db.VarChar(66)
  txHash         String?            @map("tx_hash") @db.VarChar(66)
  status         DisbursementStatus @default(pending)
  claimedAt      DateTime?          @map("claimed_at") @db.Timestamptz
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  rumahTangga RumahTangga    @relation(fields: [rumahTanggaId], references: [id], onDelete: Restrict)
  periode     PeriodeProgram @relation(fields: [periodeId], references: [id], onDelete: Restrict)

  @@unique([periodeId, rumahTanggaId])
  @@map("disbursement_record")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.Uuid
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_log")
}

/// Jalur sanggahan/koreksi data — 01-PRD.md (tabel risiko titik cutoff) dan
/// 07-Security-Privacy-Ethics.md §4.4: warga yang merasa data/skornya keliru
/// bisa mengajukan koreksi lewat verifikator, BUKAN override skor manual.
/// Menyetujui sanggahan cuma mengubah field mentah `RumahTangga` — re-kalkulasi
/// skor terjadi otomatis di run berikutnya (`run-clustering`/`run-topsis` selalu
/// baca data terbaru), tidak ada jalur override skor langsung di model ini.
model SanggahanRequest {
  id             String          @id @default(uuid()) @db.Uuid
  rumahTanggaId  String          @map("rumah_tangga_id") @db.Uuid
  diajukanOlehId String          @map("diajukan_oleh_id") @db.Uuid
  alasan         String          @db.Text
  /// Subset field RumahTangga yang diusulkan berubah, mis.
  /// { "pendapatan_per_kapita": 450000, "skor_kondisi_rumah": 3 }
  dataBaru       Json            @map("data_baru")
  status         StatusSanggahan @default(pending)
  catatanReview  String?         @map("catatan_review") @db.Text
  ditinjauOlehId String?         @map("ditinjau_oleh_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  reviewedAt     DateTime?       @map("reviewed_at") @db.Timestamptz

  rumahTangga  RumahTangga @relation(fields: [rumahTanggaId], references: [id], onDelete: Cascade)
  diajukanOleh User        @relation("SanggahanDiajukan", fields: [diajukanOlehId], references: [id])
  ditinjauOleh User?       @relation("SanggahanDitinjau", fields: [ditinjauOlehId], references: [id])

  @@map("sanggahan_request")
}
